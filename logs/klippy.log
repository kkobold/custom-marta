	SET_DISPLAY_TEXT MSG="Homing..."
	M140 S{target_bed}
	M104 S{target_extruder}
	M300
	STATUS_HOMING
	_CG28
	G90
	
	
	BED_MESH_CLEAR
	
	
	
	SET_DISPLAY_TEXT MSG="Bed: {target_bed}c"
	STATUS_HEATING
	M106 S255
	
	
	
	
	G1 X{x_wait} Y{y_wait} Z15 F9000
	M300
	M300
	M190 S{target_bed}
	M300
	M300
	M300
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	SET_DISPLAY_TEXT MSG="Bed mesh"
	STATUS_MESHING
	bed_mesh_calibrate
	M300
	M300
	M300
	M300
	
	
	SET_DISPLAY_TEXT MSG="Hotend: {target_extruder}c"
